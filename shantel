      </nav>
    </div>
  </header>

  <main>
    <div class="container">
      <div class="page-title"><h2>Contact Us</h2><p>We would love to hear from you.</p></div>

      <div class="contact-layout">
        <section class="info">
          <h3>Visit Us</h3>
          <p>12 Main Street, Gweru</p>
          <h3>Call Us</h3>
          <p>+263 77 000 0000</p>
          <h3>Email</h3>
          <p>info@autohub.example</p>
          <h3>Hours</h3>
          <p>Mon - Fri: 8am - 5pm<br>Sat: 8am - 1pm</p>
        </section>

        <section class="message-form">
          <h3>Send a Message</h3>
          <form>
            <label for="cname">Name</label>
            <input type="text" id="cname">

            <label for="cemail">Email</label>
            <input type="email" id="cemail">

            <label for="msg">Message</label>
            <textarea id="msg" rows="5"></textarea>

            <button type="submit" class="button">Send</button>
          </form>
        </section>
      </div>
    </div>
  </main>

  <footer>
    <div class="container">
